.vscode/**
.claude/**
.github/**
.mimocode/**
scripts/**
src/**
webview/**
shared/**
packages/**
pnpm-workspace.yaml
out/**
coverage/**
node_modules/**
docs/**
test/**
e2e/**
samples/**
# README screenshots. `pnpm run package` passes `--baseImagesUrl`, so every
# relative image path in the packaged readme is rewritten to an absolute
# github.com/raw URL: the local copies inside the VSIX can never be reached by
# anything that reads it. Verify with `unzip -p <vsix> extension/readme.md`.
images/**
# Brand sources. `media/icon.png` is generated from them and is the only thing
# the manifest points at; nothing reads an SVG at runtime, and vsce refuses an
# SVG icon outright, so shipping them would be bytes no reader can reach.
media/*.svg
__mocks__/**
releases/**
.vscode-test/**
# The bare entry too: in a git worktree `.vscode-test` is a SYMLINK to the main
# checkout's directory, `dir/**` matches contents but never the symlink itself,
# and vsce then collects it as a file entry — vsce 3's secret scanner tries to
# read() the directory and packaging dies with EISDIR (vsce 2 silently packaged
# the entry). Same reasoning applies to any dir glob here, but this is the only
# path worktree setup symlinks today.
.vscode-test
.e2e-shots/**
# Built by `pnpm perf:ab` / `perf:typing:ab`, which create them and never
# remove them. Gitignored, but .vscodeignore does not honor .gitignore — so
# without these two lines any local A/B run poisons the next `pnpm run package`
# with two full copies of the bundle (318 files / 30 MB vs 114 / 10 MB).
dist-base/**
dist-head/**
# The --vscode-* palette for hosts that are not VS Code (jot/, the e2e
# harness). Inside the extension the workbench injects the real palette, so
# this asset has no reader there.
dist/hostPalette.css
.gitignore
.editorconfig
.prettierignore
AGENTS.md
CLAUDE.md
tsconfig*.json
vitest*.ts
esbuild.mjs
pnpm-lock.yaml
*.vsix
**/*.map
**/*.ts
