node_modules/
dist/
dist-base/
dist-head/
out/
coverage/
test/
# ...but keep the @vscode/test-electron integration suite (the broad `test/` above
# would otherwise ignore it). Its compiled output still lands in the ignored out/.
!src/test/
!src/test/**
*.vsix
releases/
# Birta Writer (mac/): SwiftPM build products and the assembled .app
mac/.build/
mac/build/
.DS_Store
.docs
.idea
.claude/settings.local.json
# The private-material guard's pattern list is the roster of what is
# private, so committing it to a public repo would publish what it
# protects. Untracked on purpose; a fresh clone starts unguarded.
.claude/private-material-guard
# Agent worktrees are created under the repo root; without this they show up as
# untracked files in the main checkout's `git status`.
.claude/worktrees/
.env
.env.*
.e2e-shots/
# No trailing slash: the integration harness can leave a SYMLINK named
# `.vscode-test`, and a directory-only pattern does not match one.
.vscode-test
