  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#b07a32",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Plain text / variables — weight and space, not color",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable variable"
      ],
      "settings": {
        "foreground": "#ffcf8a"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#c28d42"
      }
    },
    {
      "name": "Language variables (this, self, super)",
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#ffd9a0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords, storage, control, modifiers",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#ffb454"
      }
    },
    {
      "name": "Operators & punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#c28d42"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#cf9b56"
      }
    },
    {
      "name": "String escapes & template expressions",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#e6a64f"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#cf9b56"
      }
    },
    {
      "name": "Numbers, constants, booleans, language constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#e6a64f"
      }
    },
    {
      "name": "Other constants (enums, symbols)",
      "scope": [
        "constant.other",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#e6a64f"
      }
    },
    {
      "name": "Functions & methods — the name's hue",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#ffd9a0"
      }
    },
    {
      "name": "Decorators & annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "meta.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#ffd9a0"
      }
    },
    {
      "name": "Types, classes, interfaces, namespaces — tag intent",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.type.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#f3ae54"
      }
    },
    {
      "name": "Built-in / support types & constants",
      "scope": [
        "support.type.primitive",
        "support.constant",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#f3ae54"
      }
    },
    {
      "name": "Object properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#ffcf8a"
      }
    },
    {
      "name": "Enum members",
      "scope": [
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#e6a64f"
      }
    },
    {
      "name": "HTML/XML tags — tag intent (steel)",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#f3ae54"
      }
    },
    {
      "name": "HTML/JSX attribute names — the mark hue (tag / attr / value)",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#ffd9a0"
      }
    },
    {
      "name": "JSX component names",
      "scope": [
        "support.class.component",
        "entity.name.tag.jsx"
      ],
      "settings": {
        "foreground": "#f3ae54"
      }
    },
    {
      "name": "CSS selectors — classes & ids",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#f3ae54"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#ffcf8a"
      }
    },
    {
      "name": "CSS property values & keywords",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#e6a64f"
      }
    },
    {
      "name": "Tag / element (Markdown, misc)",
      "scope": [
        "meta.tag",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#ffcf8a"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f87171"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#eab308",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#f3ae54"
      }
    },
    {
      "name": "YAML keys",
      "scope": [
        "entity.name.tag.yaml",
        "punctuation.definition.block.sequence.item.yaml"
      ],
      "settings": {
        "foreground": "#f3ae54"
      }
    },
    {
      "name": "Markdown headings — fg bold (in-article heads rest fg-bold)",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "markup.heading.markdown punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#ffcf8a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ffcf8a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#ffcf8a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline code — the mark hue (fenced BLOCKS stay default fg)",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#ffd9a0"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "foreground": "#f3ae54",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown link text / labels",
      "scope": [
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#ffb454"
      }
    },
    {
      "name": "Markdown blockquote — muted, like a #spark quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#b07a32",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list markers — muted (bullets are neutral)",
      "scope": [
        "markup.list punctuation.definition.list.begin",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#b07a32"
      }
    },
    {
      "name": "Markdown inserted (diff-in-md)",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#cf9b56"
      }
    },
    {
      "name": "Markdown deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f87171"
      }
    },
    {
      "name": "Diff header",
      "scope": [
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#ffb454"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": {
      "foreground": "#b07a32",
      "fontStyle": "italic"
    },
    "keyword": "#ffb454",
    "type": "#f3ae54",
    "class": "#f3ae54",
    "interface": "#f3ae54",
    "enum": "#f3ae54",
    "typeParameter": "#f3ae54",
    "namespace": "#f3ae54",
    "struct": "#f3ae54",
    "function": "#ffd9a0",
    "method": "#ffd9a0",
    "macro": "#ffd9a0",
    "decorator": "#ffd9a0",
    "string": "#cf9b56",
    "number": "#e6a64f",
    "regexp": "#cf9b56",
    "variable": "#ffcf8a",
    "variable.readonly": "#e6a64f",
    "parameter": "#c28d42",
    "property": "#ffcf8a",
    "property.readonly": "#e6a64f",
    "enumMember": "#e6a64f",
    "event": "#ffd9a0",
    "operator": "#c28d42",
    "*.defaultLibrary": "#f3ae54",
    "selfKeyword": {
