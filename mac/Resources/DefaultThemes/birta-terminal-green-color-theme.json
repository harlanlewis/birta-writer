  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#289552",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Plain text / variables — weight and space, not color",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable variable"
      ],
      "settings": {
        "foreground": "#54ff8c"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#2e9e52"
      }
    },
    {
      "name": "Language variables (this, self, super)",
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#5cf59b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords, storage, control, modifiers",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#2bcf70"
      }
    },
    {
      "name": "Operators & punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#2e9e52"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#38b463"
      }
    },
    {
      "name": "String escapes & template expressions",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#39c266"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#38b463"
      }
    },
    {
      "name": "Numbers, constants, booleans, language constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#39c266"
      }
    },
    {
      "name": "Other constants (enums, symbols)",
      "scope": [
        "constant.other",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#39c266"
      }
    },
    {
      "name": "Functions & methods — the name's hue",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#5cf59b"
      }
    },
    {
      "name": "Decorators & annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "meta.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#5cf59b"
      }
    },
    {
      "name": "Types, classes, interfaces, namespaces — tag intent",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.type.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#3dd474"
      }
    },
    {
      "name": "Built-in / support types & constants",
      "scope": [
        "support.type.primitive",
        "support.constant",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#3dd474"
      }
    },
    {
      "name": "Object properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#54ff8c"
      }
    },
    {
      "name": "Enum members",
      "scope": [
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#39c266"
      }
    },
    {
      "name": "HTML/XML tags — tag intent (steel)",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#3dd474"
      }
    },
    {
      "name": "HTML/JSX attribute names — the mark hue (tag / attr / value)",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#5cf59b"
      }
    },
    {
      "name": "JSX component names",
      "scope": [
        "support.class.component",
        "entity.name.tag.jsx"
      ],
      "settings": {
        "foreground": "#3dd474"
      }
    },
    {
      "name": "CSS selectors — classes & ids",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#3dd474"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#54ff8c"
      }
    },
    {
      "name": "CSS property values & keywords",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#39c266"
      }
    },
    {
      "name": "Tag / element (Markdown, misc)",
      "scope": [
        "meta.tag",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#54ff8c"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f87171"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#eab308",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#3dd474"
      }
    },
    {
      "name": "YAML keys",
      "scope": [
        "entity.name.tag.yaml",
        "punctuation.definition.block.sequence.item.yaml"
      ],
      "settings": {
        "foreground": "#3dd474"
      }
    },
    {
      "name": "Markdown headings — fg bold (in-article heads rest fg-bold)",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "markup.heading.markdown punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#54ff8c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#54ff8c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#54ff8c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline code — the mark hue (fenced BLOCKS stay default fg)",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#5cf59b"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "foreground": "#3dd474",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown link text / labels",
      "scope": [
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#2bcf70"
      }
    },
    {
      "name": "Markdown blockquote — muted, like a #spark quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#289552",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list markers — muted (bullets are neutral)",
      "scope": [
        "markup.list punctuation.definition.list.begin",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#289552"
      }
    },
    {
      "name": "Markdown inserted (diff-in-md)",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#38b463"
      }
    },
    {
      "name": "Markdown deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f87171"
      }
    },
    {
      "name": "Diff header",
      "scope": [
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#2bcf70"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": {
      "foreground": "#289552",
      "fontStyle": "italic"
    },
    "keyword": "#2bcf70",
    "type": "#3dd474",
    "class": "#3dd474",
    "interface": "#3dd474",
    "enum": "#3dd474",
    "typeParameter": "#3dd474",
    "namespace": "#3dd474",
    "struct": "#3dd474",
    "function": "#5cf59b",
    "method": "#5cf59b",
    "macro": "#5cf59b",
    "decorator": "#5cf59b",
    "string": "#38b463",
    "number": "#39c266",
    "regexp": "#38b463",
    "variable": "#54ff8c",
    "variable.readonly": "#39c266",
    "parameter": "#2e9e52",
    "property": "#54ff8c",
    "property.readonly": "#39c266",
    "enumMember": "#39c266",
    "event": "#5cf59b",
    "operator": "#2e9e52",
    "*.defaultLibrary": "#3dd474",
    "selfKeyword": {
